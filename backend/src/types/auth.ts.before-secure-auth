export type UserRole = "CUSTOMER" | "SELLER" | "ADMIN";

export interface PublicUser {
  id: string;
  email: string;
  firstName: string;
  lastName: string;
  role: UserRole;
  createdAt: string;
}

export interface UserRecord extends PublicUser {
  passwordHash: string;
}

export interface JwtPayload {
  sub: string;
  email: string;
  role: UserRole;
}
