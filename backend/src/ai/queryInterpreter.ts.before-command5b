export interface ShoppingIntent {
  originalMessage: string;
  search: string;
  minPrice?: number;
  maxPrice?: number;
  inStockOnly: boolean;
  limit: number;
}

function extractNumber(
  text: string,
  patterns: RegExp[],
): number | undefined {
  for (const pattern of patterns) {
    const match = text.match(pattern);

    if (match?.[1]) {
      const value = Number(match[1]);
      if (Number.isFinite(value)) return value;
    }
  }

  return undefined;
}

export function interpretShoppingQuery(
  rawMessage: string,
): ShoppingIntent {
  const originalMessage = rawMessage.trim();

  const maxPrice = extractNumber(originalMessage, [
    /(?:under|below|less than|up to|max(?:imum)?)\s*£?\s*(\d+(?:\.\d+)?)/i,
    /£\s*(\d+(?:\.\d+)?)\s*(?:or less|max(?:imum)?)/i,
  ]);

  const minPrice = extractNumber(originalMessage, [
    /(?:over|above|more than|min(?:imum)?)\s*£?\s*(\d+(?:\.\d+)?)/i,
  ]);

  const search = originalMessage
    .replace(
      /(?:under|below|less than|up to|max(?:imum)?)\s*£?\s*\d+(?:\.\d+)?/gi,
      " ",
    )
    .replace(
      /(?:over|above|more than|min(?:imum)?)\s*£?\s*\d+(?:\.\d+)?/gi,
      " ",
    )
    .replace(
      /\b(find|show|search|recommend|suggest|give|me|please|products?|items?|something|for|the|a|an)\b/gi,
      " ",
    )
    .replace(/\s+/g, " ")
    .trim();

  return {
    originalMessage,
    search,
    minPrice,
    maxPrice,
    inStockOnly: true,
    limit: 5,
  };
}
