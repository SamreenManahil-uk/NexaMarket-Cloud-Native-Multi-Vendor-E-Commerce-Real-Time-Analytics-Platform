PORT=3000

# Local development examples only. Never use these credentials in production.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexamarket
DB_USER=nexamarket
DB_PASSWORD=nexamarket_dev

# Authentication
# Replace with a long random secret in each environment.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h

KAFKA_BROKERS=localhost:9094
KAFKA_CLIENT_ID=nexamarket-api

# Frontend / authentication URLs
FRONTEND_URL=http://localhost:5175
BACKEND_URL=http://localhost:3000

# Google OAuth
# Create a Web application OAuth client in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# SMTP email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=NexaMarket <no-reply@example.com>

# Authentication security
EMAIL_VERIFICATION_TTL_MINUTES=30
PASSWORD_RESET_TTL_MINUTES=30
