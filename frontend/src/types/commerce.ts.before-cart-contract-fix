export interface CartItem {
  item_id: string;
  product_id: string;
  quantity: number;
  name: string;
  slug: string;
  price: string;
  image_url: string | null;
  stock: number;
  seller_name: string;
}

export interface CartData {
  cartId?: string;
  items: CartItem[];
  subtotal?: string | number;
}

export interface CartResponse {
  data: CartData | CartItem[];
}

export interface WishlistItem {
  item_id: string;
  product_id: string;
  created_at: string;
  name: string;
  slug: string;
  price: string;
  image_url: string | null;
  stock: number;
  seller_name: string;
}

export interface WishlistResponse {
  data: WishlistItem[];
}
