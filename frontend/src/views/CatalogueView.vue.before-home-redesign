      <div v-else-if="loading" class="nx-product-grid">
        <div v-for="i in 5" :key="i" class="nx-product-card nx-loading-card">
          <div class="nx-product-image skeleton"></div>
          <div class="nx-product-info">
            <div class="skeleton nx-line"></div>
            <div class="skeleton nx-line short"></div>
          </div>
        </div>
      </div>

      <div v-else-if="visibleProducts.length" class="nx-product-grid">
        <article
          v-for="product in visibleProducts"
          :key="product.id"
          class="nx-product-card"
          @click="openProduct(product.id)"
        >
          <div class="nx-product-image">
            <img
              v-if="product.image_url"
              :src="product.image_url"
              :alt="product.name"
              class="nx-product-photo"
              loading="lazy"
            />

            <div v-else class="nx-product-photo-fallback">
              <span>Product image unavailable</span>
            </div>

            <button
              class="nx-heart"
              type="button"
              :disabled="busyProduct === product.id"
              :aria-label="`Save ${product.name} to wishlist`"
              @click.stop="addProductToWishlist(product)"
            >
              <svg
                viewBox="0 0 24 24"
                width="20"
                height="20"
                aria-hidden="true"
              >
                <path
                  d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78Z"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>
          </div>

          <div class="nx-product-info">
            <p>{{ product.name }}</p>


            <div class="nx-product-bottom">
              <strong>{{ productPrice(product) }}</strong>
              <div class="nx-card-actions">
                <button class="nx-view-product" type="button" @click.stop="openProduct(product.id)">View Product</button>
                <button class="nx-add-cart" type="button" :disabled="product.available_quantity <= 0 || busyProduct === product.id" @click.stop="addProductToCart(product)">{{ product.available_quantity <= 0 ? "Out of stock" : busyProduct === product.id ? "Adding..." : "Add to cart" }}</button>
              </div>
            </div>
          </div>
        </article>
      </div>

      <div v-else class="nx-empty">
        No products are currently available.
      </div>
    </section>

    <p v-if="actionMessage" class="nx-action-message" role="status">{{ actionMessage }}</p>

        <!-- TRUST STRIP -->
