<script setup lang="ts">
import { computed, onMounted, ref, watch } from "vue";
import { useRoute, useRouter } from "vue-router";
import { trackClickstream } from "../services/clickstream";
import { api, errorMessage } from "../services/api";
import type { Category, Product } from "../types/catalogue";

const router = useRouter();
const route = useRoute();
const searchQuery = ref(String(route.query.search ?? ""));

const categories = ref<Category[]>([]);
const products = ref<Product[]>([]);
const loading = ref(true);
const error = ref("");

const categoryIcons = ["💻", "📱", "🎧", "🏠", "🎮", "⌚", "📷", "⚡"];

const visibleProducts = computed(() => products.value.slice(0, 5));

async function loadHome() {
  const controller = new AbortController();

  try {
    loading.value = true;
    error.value = "";

    const [categoryResponse, productResponse] = await Promise.all([
      api.categories(controller.signal),
      api.products(1, 8, String(route.query.category ?? ""), String(route.query.search ?? ""), controller.signal),
    ]);

    categories.value = categoryResponse.data ?? [];
    products.value = productResponse.data ?? [];
  } catch (err) {
    console.error(err);
    error.value = errorMessage(err);
  } finally {
    loading.value = false;
  }
}

async function submitSearch() {
  const query = searchQuery.value.trim();
  console.log("NEXA_SEARCH_SUBMIT", query);
  if (!query) return;
  await router.push({ path: "/", query: { search: query }, hash: "#catalogue" });
  void trackClickstream("SEARCH", { searchQuery: query, path: route.fullPath });
  await loadHome();
}

function openProduct(id: string) {
  router.push(`/products/${id}`);
}

function categoryName(category: Category) {
  return category.name;
}

function productPrice(product: Product) {
  return `£${Number(product.price).toFixed(2)}`;
}

watch(() => [route.query.search, route.query.category], () => { searchQuery.value = String(route.query.search ?? ""); void loadHome(); });

onMounted(loadHome);
</script>

