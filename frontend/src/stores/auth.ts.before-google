import { computed, reactive, readonly } from "vue";
import { authApi } from "../services/auth";
import type { AuthUser } from "../types/auth";

const TOKEN_KEY = "nexamarket_access_token";

interface AuthState {
  user: AuthUser | null;
  token: string | null;
  ready: boolean;
}

const state = reactive<AuthState>({
  user: null,
  token: localStorage.getItem(TOKEN_KEY),
  ready: false,
});

function saveSession(user: AuthUser, token: string): void {
  state.user = user;
  state.token = token;
  localStorage.setItem(TOKEN_KEY, token);
}

function clearSession(): void {
  state.user = null;
  state.token = null;
  localStorage.removeItem(TOKEN_KEY);
}

async function register(input: {
  firstName: string;
  lastName: string;
  email: string;
  password: string;
}): Promise<void> {
  const result = await authApi.register(input);
  saveSession(result.user, result.accessToken);
}

async function login(input: {
  email: string;
  password: string;
}): Promise<void> {
  const result = await authApi.login(input);
  saveSession(result.user, result.accessToken);
}

async function initialise(): Promise<void> {
  if (!state.token) {
    state.ready = true;
    return;
  }

  try {
    const result = await authApi.me(state.token);
    state.user = result.user;
  } catch {
    clearSession();
  } finally {
    state.ready = true;
  }
}

export const authStore = {
  state: readonly(state),
  isAuthenticated: computed(() => Boolean(state.user && state.token)),
  register,
  login,
  logout: clearSession,
  initialise,
};
