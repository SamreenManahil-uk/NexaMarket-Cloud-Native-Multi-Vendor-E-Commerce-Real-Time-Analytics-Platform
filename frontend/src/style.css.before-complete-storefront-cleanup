/* =========================================================
   NEXAMARKET — AUTHENTICATION & ACCOUNT
   ========================================================= */

.auth-page {
  display: grid;
  grid-template-columns: minmax(0, 1.08fr) minmax(380px, 0.72fr);
  gap: clamp(40px, 7vw, 100px);
  align-items: center;
  min-height: 700px;
  padding: 72px 0 90px;
}

.auth-story {
  position: relative;
  max-width: 650px;
}

.auth-story::before {
  content: "";
  position: absolute;
  width: 340px;
  height: 340px;
  left: -150px;
  top: -100px;
  z-index: -1;
  border-radius: 50%;
  background: radial-gradient(
    circle,
    rgba(93, 111, 255, 0.13),
    transparent 68%
  );
}

.auth-story h1 {
  margin: 12px 0 24px;
  font-size: clamp(3.2rem, 6vw, 5.8rem);
  line-height: 0.94;
  letter-spacing: -0.065em;
  color: #172044;
}

.auth-story h1 em {
  font-style: normal;
  color: #5367e8;
}

.auth-story-copy {
  max-width: 550px;
  margin: 0;
  color: #68708a;
  font-size: 1.03rem;
  line-height: 1.75;
}

.auth-benefits {
  display: grid;
  gap: 0;
  max-width: 560px;
  margin-top: 38px;
}

.auth-benefits > div {
  display: grid;
  grid-template-columns: 42px 1fr;
  gap: 15px;
  align-items: start;
  padding: 17px 0;
  border-bottom: 1px solid #e9ebf4;
}

.auth-benefits > div > span {
  padding-top: 3px;
  color: #9ba2b9;
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 0.08em;
}

.auth-benefits p {
  margin: 0;
  color: #747b91;
  font-size: 0.85rem;
  line-height: 1.55;
}

.auth-benefits strong {
  display: block;
  margin-bottom: 3px;
  color: #202844;
  font-size: 0.9rem;
}

.auth-card {
  position: relative;
  overflow: hidden;
  padding: clamp(27px, 4vw, 42px);
  border: 1px solid #e8eaf3;
  border-radius: 30px;
  background: rgba(255, 255, 255, 0.96);
  box-shadow:
    0 30px 80px rgba(28, 39, 87, 0.1),
    0 3px 12px rgba(28, 39, 87, 0.04);
}

.auth-card::before {
  content: "";
  position: absolute;
  width: 160px;
  height: 160px;
  right: -70px;
  top: -80px;
  border-radius: 50%;
  background: linear-gradient(
    135deg,
    rgba(83, 103, 232, 0.16),
    rgba(121, 96, 255, 0.04)
  );
}

.auth-tabs {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5px;
  margin-bottom: 34px;
  padding: 5px;
  border-radius: 14px;
  background: #f4f5f9;
}

.auth-tabs button {
  min-height: 42px;
  border: 0;
  border-radius: 10px;
  background: transparent;
  color: #73798c;
  font: inherit;
  font-size: 0.76rem;
  font-weight: 750;
  cursor: pointer;
  transition:
    background 160ms ease,
    color 160ms ease,
    box-shadow 160ms ease;
}

.auth-tabs button.active {
  background: #ffffff;
  color: #1b2343;
  box-shadow: 0 4px 14px rgba(32, 43, 85, 0.08);
}

.auth-heading {
  display: flex;
  align-items: center;
  gap: 15px;
  margin-bottom: 28px;
}

.auth-heading h2 {
  margin: 2px 0 0;
  color: #182044;
  font-size: 1.85rem;
  letter-spacing: -0.035em;
}

.auth-heading .eyebrow {
  margin: 0;
}

.auth-mark {
  display: grid;
  flex: 0 0 auto;
  place-items: center;
  width: 52px;
  height: 52px;
  border-radius: 16px;
  background: linear-gradient(135deg, #19234d, #5367e8);
  color: white;
  font-size: 0.9rem;
  font-weight: 900;
  box-shadow: 0 10px 25px rgba(65, 82, 194, 0.22);
}

.auth-form {
  display: grid;
  gap: 18px;
}

.auth-name-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 13px;
}

.auth-form label {
  display: grid;
  gap: 8px;
  color: #353d59;
  font-size: 0.76rem;
  font-weight: 750;
}

.auth-form input {
  width: 100%;
  min-height: 52px;
  box-sizing: border-box;
  padding: 0 15px;
  border: 1px solid #dfe2ed;
  border-radius: 13px;
  outline: none;
  background: #fbfcff;
  color: #182044;
  font: inherit;
  transition:
    border-color 160ms ease,
    box-shadow 160ms ease,
    background 160ms ease;
}

.auth-form input:hover {
  border-color: #c8cde0;
}

.auth-form input:focus {
  border-color: #5367e8;
  background: #fff;
  box-shadow: 0 0 0 4px rgba(83, 103, 232, 0.1);
}

.auth-form input::placeholder {
  color: #a4a9ba;
}

.auth-form small {
  color: #8a90a3;
  font-size: 0.69rem;
  font-weight: 500;
  line-height: 1.5;
}

.auth-error {
  padding: 12px 14px;
  border: 1px solid #f1cbd0;
  border-radius: 12px;
  background: #fff4f5;
  color: #a02c3a;
  font-size: 0.78rem;
  line-height: 1.5;
}

.auth-submit {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 55px;
  margin-top: 3px;
  padding: 0 19px;
  border: 0;
  border-radius: 14px;
  background: linear-gradient(135deg, #19234d, #334db8);
  color: white;
  font: inherit;
  font-size: 0.82rem;
  font-weight: 800;
  cursor: pointer;
  box-shadow: 0 12px 25px rgba(38, 55, 133, 0.18);
  transition:
    transform 160ms ease,
    box-shadow 160ms ease;
}

.auth-submit:hover:not(:disabled) {
  transform: translateY(-1px);
  box-shadow: 0 16px 30px rgba(38, 55, 133, 0.24);
}

.auth-submit:disabled {
  cursor: wait;
  opacity: 0.65;
}

.auth-submit span {
  font-size: 1.15rem;
}

.auth-switch {
  margin: 23px 0 0;
  color: #83899b;
  text-align: center;
  font-size: 0.76rem;
}

.auth-switch button {
  margin-left: 3px;
  border: 0;
  padding: 0;
  background: transparent;
  color: #5367e8;
  font: inherit;
  font-weight: 800;
  cursor: pointer;
}

.account-utility {
  color: inherit;
  text-decoration: none;
}

.account-page {
  padding: 55px 0 90px;
}

.account-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 35px;
  overflow: hidden;
  position: relative;
  padding: clamp(32px, 5vw, 62px);
  border-radius: 30px;
  background:
    radial-gradient(
      circle at 90% 20%,
      rgba(124, 145, 255, 0.45),
      transparent 30%
    ),
    linear-gradient(135deg, #172044, #354fb8);
  color: white;
}

.account-hero h1 {
  margin: 8px 0 12px;
  font-size: clamp(2.6rem, 5vw, 4.6rem);
  line-height: 1;
  letter-spacing: -0.055em;
}

.account-hero p {
  max-width: 600px;
  margin: 0;
  color: rgba(255, 255, 255, 0.78);
  line-height: 1.65;
}

.account-avatar {
  display: grid;
  flex: 0 0 auto;
  place-items: center;
  width: 105px;
  height: 105px;
  border: 1px solid rgba(255, 255, 255, 0.25);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  font-size: 1.7rem;
  font-weight: 850;
  backdrop-filter: blur(8px);
}

.account-grid {
  display: grid;
  grid-template-columns: 1.2fr 1fr 1fr;
  gap: 18px;
  margin-top: 22px;
}

.account-grid article {
  min-height: 190px;
  padding: 26px;
  border: 1px solid #e7e9f1;
  border-radius: 22px;
  background: #fff;
  box-shadow: 0 8px 25px rgba(32, 43, 85, 0.04);
}

.account-grid h2 {
  margin: 10px 0 8px;
  color: #1c2444;
  letter-spacing: -0.025em;
}

.account-grid p {
  color: #747b90;
  line-height: 1.6;
}

.account-role {
  display: inline-block;
  margin-top: 12px;
  padding: 6px 10px;
  border-radius: 8px;
  background: #eef0ff;
  color: #5367e8;
  font-size: 0.68rem;
  font-weight: 850;
  letter-spacing: 0.05em;
}

.account-feature-card > span:first-child {
  color: #5367e8;
  font-size: 1.6rem;
}

.account-logout {
  margin-top: 24px;
  padding: 12px 19px;
  border: 1px solid #dfe2ec;
  border-radius: 12px;
  background: white;
  color: #28304d;
  font: inherit;
  font-size: 0.78rem;
  font-weight: 800;
  cursor: pointer;
}

@media (max-width: 1050px) {
  .auth-page {
    grid-template-columns: minmax(0, 1fr) minmax(360px, 0.85fr);
    gap: 45px;
  }
}

@media (max-width: 850px) {
  .auth-page {
    grid-template-columns: 1fr;
    min-height: auto;
    padding: 45px 0 70px;
  }

  .auth-story {
    max-width: 700px;
  }

  .auth-story h1 {
    font-size: clamp(3rem, 10vw, 5rem);
  }

  .auth-benefits {
    display: none;
  }

  .auth-card {
    width: 100%;
    max-width: 580px;
    box-sizing: border-box;
  }

  .account-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 600px) {
  .auth-page {
    gap: 28px;
    padding: 30px 0 60px;
  }

  .auth-story h1 {
    font-size: 2.75rem;
  }

  .auth-story-copy {
    font-size: 0.9rem;
  }

  .auth-card {
    padding: 21px;
    border-radius: 22px;
  }

  .auth-name-grid {
    grid-template-columns: 1fr;
  }

  .auth-heading h2 {
    font-size: 1.55rem;
  }

  .account-hero {
    align-items: flex-start;
    flex-direction: column-reverse;
    border-radius: 22px;
  }

  .account-avatar {
    width: 72px;
    height: 72px;
    font-size: 1.2rem;
  }
}


/* =========================================================
   NEXAMARKET — SHOPCART-INSPIRED HOMEPAGE
   ========================================================= */

:root {
  --nx-ink: #11152b;
  --nx-muted: #74788d;
  --nx-purple: #6955e8;
  --nx-purple-dark: #4c3bc8;
  --nx-soft: #f4f2ff;
  --nx-border: #ececf2;
  --nx-bg: #ffffff;
}

.nx-home {
  width: 100%;
  max-width: 1440px;
  margin: 0 auto;
  padding-bottom: 70px;
  color: var(--nx-ink);
}

.nx-hero {
  min-height: 430px;
  margin: 26px 0 45px;
  padding: 58px 64px;
  border-radius: 26px;
  overflow: hidden;
  position: relative;
  display: flex;
  align-items: center;
  background:
    radial-gradient(circle at 75% 30%, rgba(151,130,255,.38), transparent 28%),
    linear-gradient(115deg, #f3f1ff 0%, #eceaff 48%, #f8f7ff 100%);
}

.nx-hero-copy {
  position: relative;
  z-index: 3;
  width: 48%;
}

.nx-eyebrow,
.nx-small-label {
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .13em;
  color: var(--nx-purple);
}

.nx-hero h1 {
  margin: 13px 0 17px;
  font-size: clamp(43px, 5vw, 67px);
  line-height: .98;
  letter-spacing: -.055em;
  font-weight: 850;
}

.nx-hero p {
  max-width: 490px;
  margin: 0;
  color: #62667b;
  font-size: 16px;
  line-height: 1.65;
}

.nx-hero-actions {
  display: flex;
  gap: 12px;
  margin-top: 27px;
}

.nx-primary,
.nx-secondary {
  border: 0;
  border-radius: 9px;
  padding: 14px 21px;
  font-weight: 750;
  cursor: pointer;
  transition: transform .2s ease, box-shadow .2s ease;
}

.nx-primary {
  color: white;
  background: var(--nx-ink);
  box-shadow: 0 10px 25px rgba(17,21,43,.18);
}

.nx-secondary {
  color: var(--nx-ink);
  background: white;
  border: 1px solid #e5e3ef;
}

.nx-primary:hover,
.nx-secondary:hover {
  transform: translateY(-2px);
}

.nx-hero-art {
  position: absolute;
  right: 1%;
  top: 0;
  width: 53%;
  height: 100%;
}

.nx-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(2px);
}

.nx-orb-one {
  width: 290px;
  height: 290px;
  right: 18%;
  top: 14%;
  background: linear-gradient(135deg,#d9d1ff,#7c69ed);
  opacity: .55;
}

.nx-orb-two {
  width: 170px;
  height: 170px;
  right: 2%;
  bottom: 7%;
  background: #c8f0ff;
  opacity: .7;
}

.nx-device {
  position: absolute;
  box-shadow: 0 25px 45px rgba(30,25,75,.2);
}

.nx-laptop {
  right: 20%;
  top: 22%;
  width: 310px;
  transform: rotate(-3deg);
}

.nx-screen {
  height: 185px;
  padding: 10px;
  border-radius: 15px 15px 4px 4px;
  background: #202238;
}

.nx-screen-glow {
  height: 100%;
  border-radius: 8px;
  background: linear-gradient(135deg,#bca7ff,#5b4ed5 52%,#a9d9ff);
}

.nx-keyboard {
  height: 12px;
  margin: 0 -18px;
  border-radius: 0 0 15px 15px;
  background: #d7d9e5;
}

.nx-phone {
  right: 6%;
  top: 37%;
  width: 78px;
  height: 155px;
  padding: 7px;
  border-radius: 17px;
  background: #15182b;
  transform: rotate(10deg);
}

.nx-phone-screen {
  height: 100%;
  display: grid;
  place-items: center;
  border-radius: 11px;
  color: white;
  font-weight: 900;
  background: linear-gradient(145deg,#7459ed,#161b55);
}

.nx-watch {
  right: 9%;
  top: 12%;
  width: 78px;
  height: 96px;
  border-radius: 20px;
  background: #15182b;
  display: grid;
  place-items: center;
  transform: rotate(8deg);
}

.nx-watch-face {
  width: 55px;
  height: 55px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  color: white;
  font-size: 10px;
  background: #252b4b;
}

.nx-headphones {
  position: absolute;
  left: 8%;
  bottom: 10%;
  width: 145px;
  height: 120px;
  border: 22px solid #24263a;
  border-bottom: 0;
  border-radius: 80px 80px 0 0;
  transform: rotate(-13deg);
}

.nx-headphones span {
  position: absolute;
  bottom: -25px;
  width: 43px;
  height: 60px;
  border-radius: 16px;
  background: #24263a;
}

.nx-headphones span:first-child { left: -22px; }
.nx-headphones span:last-child { right: -22px; }

.nx-section {
  margin: 0 0 42px;
}

.nx-section-heading {
  display: flex;
  justify-content: space-between;
  align-items: end;
  margin-bottom: 21px;
}

.nx-section-heading h2 {
  margin: 5px 0 0;
  font-size: 29px;
  line-height: 1.1;
  letter-spacing: -.04em;
}

.nx-section-heading p {
  margin: 7px 0 0;
  color: var(--nx-muted);
  font-size: 13px;
}

.nx-view-all {
  color: var(--nx-ink);
  font-size: 13px;
  font-weight: 750;
  cursor: pointer;
}

.nx-category-row {
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  gap: 13px;
}

.nx-category {
  border: 0;
  background: transparent;
  cursor: pointer;
  color: var(--nx-ink);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 9px;
}

.nx-category-icon {
  width: 78px;
  height: 78px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  font-size: 31px;
  background: #f3f1ff;
  border: 7px solid #faf9ff;
  box-shadow: 0 5px 18px rgba(38,31,100,.07);
  transition: transform .2s ease;
}

.nx-category:nth-child(2n) .nx-category-icon {
  background: #f8eefc;
}

.nx-category:nth-child(3n) .nx-category-icon {
  background: #edf8ff;
}

.nx-category:hover .nx-category-icon {
  transform: translateY(-5px);
}

.nx-category strong {
  font-size: 12px;
  text-align: center;
  line-height: 1.2;
}

.nx-promos {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px;
  margin-bottom: 48px;
}

.nx-promo {
  min-height: 190px;
  border-radius: 20px;
  padding: 27px 32px;
  overflow: hidden;
  position: relative;
}

.nx-promo-purple {
  background: linear-gradient(110deg,#eae5ff,#d6ceff);
}

.nx-promo-warm {
  background: linear-gradient(110deg,#fff2e8,#f7e6d7);
}

.nx-promo span {
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .1em;
}

.nx-promo h3 {
  margin: 8px 0 6px;
  font-size: 25px;
  line-height: 1.05;
  letter-spacing: -.04em;
}

.nx-promo p {
  margin: 0;
  color: #666679;
  font-size: 12px;
}

.nx-promo button {
  margin-top: 17px;
  border: 0;
  border-radius: 7px;
  padding: 10px 15px;
  color: white;
  background: var(--nx-ink);
  font-size: 11px;
  font-weight: 700;
  cursor: pointer;
}

.nx-promo-object {
  position: absolute;
  right: 8%;
  top: 50%;
  transform: translateY(-50%);
}

.nx-audio {
  font-size: 120px;
  color: #5144bb;
  opacity: .55;
}

.nx-home-object {
  font-size: 150px;
  color: #c28b68;
  opacity: .35;
}

.nx-product-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 15px;
}

.nx-product-card {
  overflow: hidden;
  cursor: pointer;
  border: 1px solid var(--nx-border);
  border-radius: 14px;
  background: white;
  transition: transform .2s ease, box-shadow .2s ease;
}

.nx-product-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 18px 40px rgba(29,29,58,.09);
}

.nx-product-image {
  height: 220px;
  position: relative;
  background: #f5f5f8;
  display: grid;
  place-items: center;
}

.nx-product-badge {
  position: absolute;
  top: 10px;
  left: 10px;
  padding: 5px 8px;
  border-radius: 5px;
  color: white;
  background: #15182b;
  font-size: 9px;
  font-weight: 800;
}

.nx-heart {
  position: absolute;
  right: 10px;
  top: 8px;
  width: 30px;
  height: 30px;
  border: 0;
  border-radius: 50%;
  background: white;
  font-size: 17px;
  cursor: pointer;
}

.nx-product-placeholder {
  width: 145px;
  height: 145px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: radial-gradient(circle,#ffffff,#ebeaf5);
  font-size: 62px;
}

.nx-product-info {
  padding: 14px;
}

.nx-product-info p {
  min-height: 34px;
  margin: 0;
  font-size: 13px;
  line-height: 1.35;
  font-weight: 650;
}

.nx-rating {
  display: flex;
  gap: 5px;
  align-items: center;
  margin: 9px 0;
  font-size: 11px;
}

.nx-rating span:first-child {
  color: #f2a51a;
}

.nx-rating small {
  color: #9899a6;
}

.nx-product-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.nx-product-bottom strong {
  font-size: 17px;
  letter-spacing: -.02em;
}

.nx-product-bottom button {
  width: 34px;
  height: 34px;
  border: 0;
  border-radius: 8px;
  color: white;
  background: var(--nx-ink);
  cursor: pointer;
}

.nx-trust {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border-top: 1px solid var(--nx-border);
  border-bottom: 1px solid var(--nx-border);
  padding: 28px 5px;
  gap: 20px;
}

.nx-trust div {
  display: grid;
  grid-template-columns: 42px 1fr;
  grid-template-rows: auto auto;
  column-gap: 10px;
}

.nx-trust span {
  grid-row: 1 / 3;
  width: 40px;
  height: 40px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: #f2efff;
  font-size: 20px;
}

.nx-trust strong {
  font-size: 12px;
}

.nx-trust small {
  color: var(--nx-muted);
  font-size: 10px;
  margin-top: 3px;
}

.nx-error,
.nx-empty {
  padding: 35px;
  border-radius: 14px;
  text-align: center;
  background: #f8f8fa;
  color: var(--nx-muted);
}

.skeleton {
  background: linear-gradient(90deg,#f0f0f3,#fafafa,#f0f0f3);
  animation: nx-shimmer 1.4s infinite;
}

.nx-loading-card {
  cursor: default;
}

.nx-line {
  height: 13px;
  border-radius: 5px;
  margin-bottom: 10px;
}

.nx-line.short {
  width: 55%;
}

@keyframes nx-shimmer {
  0% { opacity: .6; }
  50% { opacity: 1; }
  100% { opacity: .6; }
}

@media (max-width: 1050px) {
  .nx-hero {
    padding: 45px;
  }

  .nx-category-row {
    grid-template-columns: repeat(4, 1fr);
    row-gap: 24px;
  }

  .nx-product-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .nx-trust {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 760px) {
  .nx-hero {
    min-height: 620px;
    padding: 35px 25px;
    align-items: flex-start;
  }

  .nx-hero-copy {
    width: 100%;
  }

  .nx-hero h1 {
    font-size: 45px;
  }

  .nx-hero-art {
    width: 100%;
    height: 300px;
    top: auto;
    bottom: 0;
    right: 0;
  }

  .nx-laptop {
    right: 20%;
    top: 22%;
    width: 230px;
  }

  .nx-screen {
    height: 135px;
  }

  .nx-phone {
    right: 5%;
    top: 35%;
  }

  .nx-watch {
    right: 8%;
    top: 5%;
  }

  .nx-headphones {
    left: 7%;
    transform: scale(.7) rotate(-13deg);
  }

  .nx-promos {
    grid-template-columns: 1fr;
  }

  .nx-product-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .nx-product-image {
    height: 180px;
  }

  .nx-trust {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 480px) {
  .nx-category-row {
    grid-template-columns: repeat(3, 1fr);
  }

  .nx-category-icon {
    width: 65px;
    height: 65px;
  }

  .nx-product-grid {
    grid-template-columns: 1fr 1fr;
    gap: 9px;
  }

  .nx-product-image {
    height: 145px;
  }

  .nx-product-placeholder {
    width: 95px;
    height: 95px;
    font-size: 42px;
  }
}

