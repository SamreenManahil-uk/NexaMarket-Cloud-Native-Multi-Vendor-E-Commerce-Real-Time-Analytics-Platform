/* =========================================================
   NEXAMARKET — SHOPCART-INSPIRED DESIGN SYSTEM
   ========================================================= */

:root {
  --nm-green: #003d29;
  --nm-green-2: #07543c;
  --nm-green-soft: #e7f1ed;
  --nm-cream: #f5f1e8;
  --nm-page: #ffffff;
  --nm-text: #231f1e;
  --nm-muted: #6d6b68;
  --nm-border: #e6e4df;
  --nm-yellow: #f5e7a1;
  --nm-peach: #f4d6c5;
  --nm-pink: #f0d5dd;
  --nm-radius: 12px;
  --nm-pill: 999px;
  --nm-shadow: 0 12px 35px rgba(22, 46, 37, 0.08);
  --nm-container: 1240px;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: var(--nm-page);
  color: var(--nm-text);
  font-family:
    Inter,
    ui-sans-serif,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
  -webkit-font-smoothing: antialiased;
}

* {
  box-sizing: border-box;
}

button,
input,
select,
textarea {
  font: inherit;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

a {
  color: inherit;
}

.container {
  width: min(calc(100% - 48px), var(--nm-container));
  margin-inline: auto;
}

#main.container {
  width: 100%;
  max-width: none;
  margin: 0;
}

.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: #fff;
  border-bottom: 1px solid var(--nm-border);
}

.shopcart-topbar {
  background: var(--nm-green);
  color: #fff;
  font-size: 12px;
}

.shopcart-topbar-inner {
  min-height: 36px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.shopcart-topbar-inner > div {
  display: flex;
  align-items: center;
  gap: 12px;
}

.shopcart-topbar a {
  color: inherit;
  text-decoration: none;
}

.topbar-divider {
  opacity: 0.4;
}

.shopcart-main-header {
  min-height: 82px;
  display: flex;
  align-items: center;
  gap: 30px;
}

.shopcart-logo {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  flex: 0 0 auto;
  color: var(--nm-green);
  text-decoration: none;
  font-size: 24px;
  font-weight: 800;
  letter-spacing: -0.045em;
}

.shopcart-logo-mark {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--nm-green);
  color: #fff;
  font-size: 17px;
  font-weight: 900;
}

.brand-dot {
  color: #e89f61;
}

.desktop-primary-nav {
  display: flex;
  align-items: center;
  gap: 25px;
  white-space: nowrap;
}

.desktop-primary-nav a {
  display: flex;
  align-items: center;
  gap: 5px;
  color: #292624;
  text-decoration: none;
  font-size: 14px;
  font-weight: 650;
}

.desktop-primary-nav a:hover,
.desktop-primary-nav a.router-link-active {
  color: var(--nm-green);
}

.shopcart-search {
  position: relative;
  flex: 1 1 330px;
  max-width: 390px;
  margin-left: auto;
}

.shopcart-search input {
  width: 100%;
  height: 44px;
  padding: 0 48px 0 18px;
  border: 1px solid #d9d9d5;
  border-radius: var(--nm-pill);
  background: #f7f7f5;
  color: var(--nm-text);
  outline: none;
}

.shopcart-search input:focus {
  border-color: var(--nm-green);
  background: #fff;
  box-shadow: 0 0 0 3px rgba(0, 61, 41, 0.07);
}

.shopcart-search button {
  position: absolute;
  top: 50%;
  right: 8px;
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  transform: translateY(-50%);
  border: 0;
  border-radius: 50%;
  background: transparent;
  color: var(--nm-green);
  cursor: pointer;
  font-size: 22px;
}

.shopcart-actions {
  display: flex;
  align-items: center;
  gap: 20px;
}

.shopcart-action {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  color: var(--nm-text);
  text-decoration: none;
  font-size: 14px;
  font-weight: 650;
  white-space: nowrap;
}

.action-icon {
  font-size: 20px;
  line-height: 1;
}

.mobile-menu-button {
  display: none;
  width: 42px;
  height: 42px;
  padding: 10px;
  border: 1px solid var(--nm-border);
  border-radius: 50%;
  background: #fff;
  cursor: pointer;
}

.mobile-menu-button span {
  display: block;
  width: 100%;
  height: 2px;
  margin: 4px 0;
  background: var(--nm-green);
}

