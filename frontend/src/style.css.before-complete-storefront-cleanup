   Hero + categories + page proportions
   ========================================================= */

:root {
  --ref-green: #003d29;
  --ref-green-soft: #0a5a43;
  --ref-cream: #f6f7f2;
  --ref-blue: #d9e9f5;
  --ref-text: #17201c;
  --ref-muted: #66706b;
  --ref-line: #e5e8e5;
}

/* ---------- MAIN PAGE WIDTH ---------- */

.ref-home {
  width: min(100% - 48px, 1320px);
  margin: 0 auto;
  padding: 0 0 72px;
}

.ref-section {
  padding: 58px 0 0;
}


/* =========================================================
   HERO
   ========================================================= */

.ref-market-hero {
  position: relative;
  min-height: 515px;
  margin-top: 22px;
  overflow: hidden;

  display: grid;
  grid-template-columns: 0.92fr 1.08fr;
  align-items: stretch;

  background:
    radial-gradient(
      circle at 78% 28%,
      rgba(255,255,255,.72),
      transparent 26%
    ),
    #dbeaf4;

  border-radius: 2px;
}

.ref-market-hero-copy {
  position: relative;
  z-index: 5;

  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;

  padding: 64px 20px 64px 72px;
}

.ref-hero-eyebrow {
  display: inline-block;
  margin-bottom: 16px;

  color: var(--ref-green);
  font-size: 12px;
  line-height: 1;
  font-weight: 800;
  letter-spacing: .14em;
}

.ref-market-hero h1 {
  max-width: 600px;
  margin: 0;

  color: var(--ref-green);

  font-size: clamp(48px, 5vw, 72px);
  line-height: .98;
  letter-spacing: -0.052em;
  font-weight: 700;
}

.ref-market-hero-copy > p {
  max-width: 510px;
  margin: 24px 0 0;

  color: #3e5149;

  font-size: 17px;
  line-height: 1.65;
  font-weight: 400;
}

.ref-hero-actions {
  display: flex;
  align-items: center;
  gap: 12px;

  margin-top: 30px;
}

.ref-hero-primary,
.ref-hero-secondary {
  min-height: 48px;
  padding: 0 25px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  border-radius: 999px;

  font-size: 14px;
  line-height: 1;
  font-weight: 700;

  text-decoration: none;

  transition:
    transform .18s ease,
    background .18s ease,
    color .18s ease,
    border-color .18s ease;
}

.ref-hero-primary {
  background: var(--ref-green);
  border: 1px solid var(--ref-green);
  color: #fff;
}

.ref-hero-secondary {
  background: transparent;
  border: 1px solid rgba(0,61,41,.35);
  color: var(--ref-green);
}

.ref-hero-primary:hover,
.ref-hero-secondary:hover {
  transform: translateY(-2px);
}

.ref-hero-secondary:hover {
  background: rgba(255,255,255,.5);
}


/* ---------- HERO PRODUCT COMPOSITION ---------- */

.ref-market-hero-visual {
  position: relative;
  min-height: 515px;
}

.ref-hero-product {
  position: absolute;
  z-index: 3;

  overflow: hidden;

  background: rgba(255,255,255,.82);
  box-shadow:
    0 20px 60px rgba(25,67,55,.13),
    0 3px 10px rgba(25,67,55,.07);
}

.ref-hero-product img {
  width: 100%;
  height: 100%;

  display: block;
  object-fit: cover;
}

.ref-hero-product-main {
  width: 320px;
  height: 385px;

  right: 104px;
  top: 64px;

  border-radius: 48% 48% 28px 28px;
}

.ref-hero-product-small {
  width: 145px;
  height: 145px;

  border: 8px solid rgba(255,255,255,.62);
  border-radius: 50%;
}

.ref-hero-product-mug {
  left: 18px;
  top: 78px;
}

.ref-hero-product-bottle {
  right: 24px;
  bottom: 30px;
}

.ref-hero-shape {
  position: absolute;
  display: block;
  z-index: 1;
}

.ref-hero-shape-one {
  width: 340px;
  height: 340px;

  right: 65px;
  top: 76px;

  border: 1px solid rgba(0,61,41,.17);
  border-radius: 50%;
}

.ref-hero-shape-two {
  width: 210px;
  height: 210px;

  right: 242px;
  bottom: -72px;

  background: rgba(247,202,119,.6);
  border-radius: 50%;
}

.ref-hero-shape-three {
  width: 86px;
  height: 86px;

  left: 80px;
  bottom: 88px;

  background: rgba(236,161,170,.64);
  border-radius: 24px;
  transform: rotate(18deg);
}

.ref-hero-badge {
  position: absolute;
  z-index: 6;

  right: 310px;
  bottom: 58px;

  width: 126px;
  min-height: 84px;
  padding: 15px;

  display: flex;
  flex-direction: column;
  justify-content: center;

  background: #fff;
  border-radius: 16px;

  color: #51615a;
  font-size: 11px;
  line-height: 1.35;

  box-shadow: 0 12px 30px rgba(0,61,41,.12);
}

.ref-hero-badge strong {
  color: var(--ref-green);
  font-size: 24px;
  line-height: 1;
  margin-bottom: 6px;
}


/* =========================================================
   SECTION HEADINGS
   ========================================================= */

.ref-section-head {
  margin-bottom: 25px;
}

.ref-section-head h1,
.ref-section-head h2 {
  margin: 0;

  color: var(--ref-text);

  font-size: 27px;
  line-height: 1.2;
  letter-spacing: -0.032em;
  font-weight: 650;
}

.ref-section-head p {
  max-width: 650px;
  margin: 8px 0 0;

  color: var(--ref-muted);

  font-size: 14px;
  line-height: 1.55;
}

.ref-eyebrow {
  margin-bottom: 8px;

  color: var(--ref-green);

  font-size: 10px;
  font-weight: 800;
  letter-spacing: .12em;
}


/* =========================================================
   CATEGORIES — 6 VERTICAL CARDS
   ========================================================= */

.ref-categories-section {
  padding-top: 58px;
}

.ref-category-grid {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 18px;
}

.ref-category-card {
  position: relative;

  width: 100%;
  aspect-ratio: .82;

  padding: 0;
  overflow: hidden;

  border: 0;
  border-radius: 10px;

  background: #eef0ec;
  cursor: pointer;

  text-align: left;
}

.ref-category-card img {
  width: 100%;
  height: 100%;

  display: block;

  object-fit: cover;

  transition: transform .35s ease;
}

.ref-category-card:hover img {
  transform: scale(1.045);
}

.ref-category-overlay {
  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      to bottom,
      rgba(0,0,0,.02) 30%,
      rgba(0,0,0,.68) 100%
    );
}

.ref-category-card strong {
  position: absolute;
  z-index: 3;

  left: 17px;
  right: 17px;
  bottom: 17px;

  color: #fff;

  font-size: 16px;
  line-height: 1.2;
  font-weight: 650;

  text-shadow: 0 1px 5px rgba(0,0,0,.22);
}


/* =========================================================
   PRODUCT GRID PROPORTIONS
   ========================================================= */

.ref-product-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 27px 20px;
}

.ref-product-card {
  min-width: 0;
}

.ref-product-image {
  aspect-ratio: 1 / .93;

  overflow: hidden;

  background: #f3f4f1;
  border-radius: 10px;
}

.ref-product-image > img {
  width: 100%;
  height: 100%;

  display: block;

  object-fit: cover;

  transition: transform .3s ease;
}

.ref-product-card:hover .ref-product-image > img {
  transform: scale(1.025);
}

.ref-product-title-row {
  margin-top: 13px;
  gap: 12px;
}

.ref-product-title-row h3 {
  color: var(--ref-text);

  font-size: 15px;
  line-height: 1.35;
  font-weight: 650;
}

.ref-product-title-row > strong {
  color: var(--ref-text);

  font-size: 15px;
  line-height: 1.35;
  font-weight: 700;
}

.ref-product-description {
  margin-top: 6px;

  color: #69736e;

  font-size: 12px;
  line-height: 1.5;
}

.ref-product-meta {
  margin-top: 7px;

  color: #63716a;

  font-size: 11px;
}

.ref-add-cart {
  margin-top: 12px;
  min-height: 39px;
  padding: 0 18px;

  border: 1px solid #24332d;
  border-radius: 999px;

  background: #fff;
  color: #1b2923;

  font-size: 12px;
  font-weight: 700;
}

.ref-add-cart:hover:not(:disabled) {
  background: var(--ref-green);
  border-color: var(--ref-green);
  color: #fff;
}


/* =========================================================
   HEADER PRECISION OVERRIDES
   ========================================================= */

.shopcart-topbar {
  background: var(--ref-green);
}

.shopcart-topbar-inner {
  min-height: 35px;

  font-size: 11px;
  letter-spacing: .01em;
}

.shopcart-main-header {
  min-height: 78px;
}

.shopcart-logo {
  color: var(--ref-green);

  font-size: 23px;
  font-weight: 750;
  letter-spacing: -0.04em;
}

.shopcart-logo-mark {
  width: 35px;
  height: 35px;

  font-size: 17px;
}

.desktop-primary-nav {
  gap: 27px;
}

.desktop-primary-nav a {
  color: #26322d;

  font-size: 13px;
  font-weight: 550;
}

.shopcart-search {
  max-width: 320px;
  height: 42px;
}

.shopcart-search input {
  font-size: 12px;
}

.shopcart-action {
  color: #26322d;

  font-size: 12px;
  font-weight: 550;
}

.header-svg-icon.action-icon {
  width: 21px;
  height: 21px;
}


/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 1180px) {
  .ref-home {
    width: min(100% - 36px, 1120px);
  }

  .ref-market-hero {
    grid-template-columns: 1fr 1fr;
  }

  .ref-market-hero-copy {
    padding-left: 48px;
  }

  .ref-hero-product-main {
    width: 280px;
    height: 350px;
    right: 60px;
  }

  .ref-hero-product-mug {
    left: 0;
  }

  .ref-category-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}


@media (max-width: 900px) {
  .ref-home {
    width: min(100% - 28px, 860px);
  }

  .ref-market-hero {
    min-height: auto;
    grid-template-columns: 1fr;
  }

  .ref-market-hero-copy {
    padding: 52px 42px 30px;
  }

  .ref-market-hero h1 {
    font-size: clamp(44px, 9vw, 64px);
  }

  .ref-market-hero-visual {
    min-height: 390px;
  }

  .ref-hero-product-main {
    width: 250px;
    height: 300px;

    top: 35px;
    right: 22%;
  }

  .ref-hero-product-mug {
    left: 11%;
    top: 60px;
  }

  .ref-hero-product-bottle {
    right: 9%;
  }

  .ref-product-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}


@media (max-width: 620px) {
  .ref-home {
    width: min(100% - 22px, 580px);
  }

  .ref-section {
    padding-top: 42px;
  }

  .ref-market-hero {
    margin-top: 12px;
    border-radius: 0;
  }

  .ref-market-hero-copy {
    padding: 42px 25px 20px;
  }

  .ref-market-hero h1 {
    font-size: 43px;
  }

  .ref-market-hero-copy > p {
    font-size: 14px;
  }

  .ref-hero-actions {
    flex-wrap: wrap;
  }

  .ref-market-hero-visual {
    min-height: 325px;
  }

  .ref-hero-product-main {
    width: 200px;
    height: 250px;

    right: 12%;
  }

  .ref-hero-product-small {
    width: 100px;
    height: 100px;
  }

  .ref-hero-product-mug {
    left: 5%;
  }

  .ref-hero-product-bottle {
    right: 3%;
  }

  .ref-hero-badge {
    left: 18px;
    right: auto;
    bottom: 20px;
  }

  .ref-category-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .ref-category-card strong {
    left: 13px;
    bottom: 13px;

    font-size: 14px;
  }

  .ref-product-grid {
    grid-template-columns: 1fr;
    gap: 32px;
  }

  .ref-section-head h1,
  .ref-section-head h2 {
    font-size: 23px;
  }
}
