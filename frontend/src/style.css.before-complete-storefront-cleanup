   ========================================================= */

.nx-category-row {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
}

.nx-category {
  position: relative;
  overflow: hidden;
  min-height: 210px;
  padding: 0;
  border: 0;
  border-radius: 12px;
  background: #f2f2ef;
  cursor: pointer;
}

.nx-category-image {
  position: absolute;
  inset: 0;
}

.nx-category-image::after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(
      to top,
      rgba(0, 0, 0, 0.62),
      rgba(0, 0, 0, 0.03) 60%
    );
}

.nx-category-image img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
