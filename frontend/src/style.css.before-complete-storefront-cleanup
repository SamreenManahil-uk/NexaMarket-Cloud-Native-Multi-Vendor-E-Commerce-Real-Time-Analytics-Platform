/* =========================================================
   NEXAMARKET REFERENCE STOREFRONT
   Clean isolated ref-* design system
   ========================================================= */

.ref-home {
  --ref-green: #003d29;
  --ref-text: #111111;
  --ref-muted: #666b67;
  --ref-border: #e6e6e1;
  --ref-soft: #f5f5f2;

  width: min(calc(100% - 72px), 1480px);
  margin: 0 auto;

  color: var(--ref-text);

  font-family:
    Inter,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
}


/* ---------- SECTIONS ---------- */

.ref-section {
  padding-top: 76px;
}

.ref-section-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;

  gap: 30px;

  margin-bottom: 34px;
}

.ref-eyebrow {
  display: block;

  margin-bottom: 9px;

  color: var(--ref-green);

  font-size: 11px;
  font-weight: 800;

  letter-spacing: .13em;
}

.ref-section-head h1,
.ref-section-head h2 {
  margin: 0;

  color: var(--ref-green);

  font-size: clamp(32px, 2.7vw, 44px);
  line-height: 1.08;

  font-weight: 700;
  letter-spacing: -.045em;
}

.ref-section-head p {
  margin: 12px 0 0;

  color: #737773;

  font-size: 14px;
}

.ref-view-link {
  flex: 0 0 auto;

  color: var(--ref-green);

  font-size: 13px;
  font-weight: 700;

  text-decoration: none;
}


/* =========================================================
   CATEGORIES
   ========================================================= */

.ref-categories-section {
  padding-top: 52px;
}

.ref-category-grid {
  display: grid;

  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  gap: 20px;
}

.ref-category-card {
  position: relative;

  min-height: 320px;

  padding: 0;

  overflow: hidden;

  border: 0;
  border-radius: 8px;

  background: #eee;

  cursor: pointer;
}

.ref-category-card img {
  position: absolute;

  inset: 0;

  width: 100%;
  height: 100%;

  object-fit: cover;

  transition: transform .35s ease;
}

.ref-category-card:hover img {
  transform: scale(1.035);
}

.ref-category-overlay {
  position: absolute;

  inset: 0;

  background:
    linear-gradient(
      to top,
      rgba(0,0,0,.58),
      rgba(0,0,0,.03) 60%
    );
}

.ref-category-card strong {
  position: absolute;

  left: 22px;
  bottom: 22px;

  z-index: 2;

  color: #fff;

  font-size: 20px;
  font-weight: 700;

  letter-spacing: -.02em;
}


/* =========================================================
   PRODUCTS
   ========================================================= */

.ref-product-grid {
  display: grid;

  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  gap: 54px 22px;
}

.ref-product-card {
  min-width: 0;
}

.ref-product-image {
  position: relative;

  width: 100%;
  aspect-ratio: 1 / .82;

  overflow: hidden;

  border-radius: 8px;

  background: #f4f4f1;

  cursor: pointer;
}

.ref-product-image > img {
  width: 100%;
  height: 100%;

  display: block;

  object-fit: cover;

  transition: transform .35s ease;
}

.ref-product-card:hover .ref-product-image > img {
  transform: scale(1.025);
}

.ref-heart {
  position: absolute;

  top: 14px;
  right: 14px;

  width: 40px;
  height: 40px;

  display: grid;
  place-items: center;

  padding: 0;

  border: 0;
  border-radius: 50%;

  background: #fff;

  color: var(--ref-green);

  cursor: pointer;

  box-shadow:
    0 2px 10px rgba(0,0,0,.06);
}

.ref-heart svg {
  width: 20px;
  height: 20px;
}

.ref-heart path {
  fill: none;

  stroke: currentColor;
  stroke-width: 1.7;

  stroke-linecap: round;
  stroke-linejoin: round;
}

.ref-product-title-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;

  gap: 16px;

  margin-top: 17px;
}

.ref-product-title-row h3 {
  margin: 0;

  color: #111;

  font-size: 16px;
  line-height: 1.35;

  font-weight: 650;

  letter-spacing: -.018em;

  cursor: pointer;
}

.ref-product-title-row strong {
  flex: 0 0 auto;

  color: var(--ref-green);

  font-size: 16px;
  line-height: 1.35;
}

.ref-product-description {
  min-height: 38px;

  margin: 9px 0 0;

  color: #777a77;

  font-size: 12px;
  line-height: 1.55;
}

.ref-product-meta {
  display: flex;
  align-items: center;

  flex-wrap: wrap;

  gap: 7px;

  margin-top: 10px;

  color: #4f665d;

  font-size: 11px;
  font-weight: 600;
}

.ref-add-cart {
  min-height: 40px;

  margin-top: 15px;

  padding: 0 22px;

  border:
    1px solid
    var(--ref-green);

  border-radius: 999px;

  background: transparent;

  color: var(--ref-green);

  font-size: 12px;
  font-weight: 700;

  cursor: pointer;

  transition:
    background .2s ease,
    color .2s ease;
}

.ref-add-cart:hover:not(:disabled) {
  background: var(--ref-green);
  color: white;
}

.ref-add-cart:disabled {
  opacity: .5;
  cursor: not-allowed;
}

.ref-image-fallback {
  width: 100%;
  height: 100%;

  display: grid;
  place-items: center;

  color: #777;

  font-size: 12px;
}


/* =========================================================
   COLLECTION / BRAND CARDS
   ========================================================= */

.ref-brand-grid {
  display: grid;

  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  gap: 18px;
}

.ref-brand-card {
  min-height: 118px;

  display: flex;
  align-items: center;

  gap: 18px;

  padding: 18px;

  border-radius: 8px;

  background: #f5f5f2;
}

.ref-brand-card img {
  width: 78px;
  height: 78px;

  flex: 0 0 auto;

  object-fit: cover;

  border-radius: 50%;
}

.ref-brand-card div {
  display: flex;
  flex-direction: column;

  gap: 5px;
}

.ref-brand-card strong {
  color: #151515;

  font-size: 15px;
}

.ref-brand-card span {
  color: #777;

  font-size: 11px;
}


/* =========================================================
   FEATURE / DISCOUNT CARDS
   ========================================================= */

.ref-feature-grid {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 20px;
}

.ref-feature-card {
  min-height: 420px;

  display: grid;

  grid-template-columns:
    1fr
    .9fr;

  overflow: hidden;
}

.ref-feature-blue {
  background: #dce9e4;
}

.ref-feature-pink {
  background: #f4dfd2;
}

.ref-feature-copy {
  padding: 50px 20px 45px 45px;
}

.ref-feature-copy > span {
  color: var(--ref-green);

  font-size: 10px;
  font-weight: 800;

  letter-spacing: .12em;
}

.ref-feature-copy h3 {
  max-width: 320px;

  margin: 12px 0 14px;

  color: var(--ref-green);

  font-size: 34px;
  line-height: 1.02;

  letter-spacing: -.05em;
}

.ref-feature-copy p {
  max-width: 330px;

  margin: 0 0 26px;

  color: #65706b;

  font-size: 13px;
  line-height: 1.6;
}

.ref-feature-copy a {
  display: inline-flex;

  min-height: 42px;

  align-items: center;

  padding: 0 20px;

  border-radius: 999px;

  background: var(--ref-green);

  color: white;

  font-size: 12px;
  font-weight: 700;

  text-decoration: none;
}

.ref-feature-image {
  min-width: 0;
}

.ref-feature-image img {
  width: 100%;
  height: 100%;

  display: block;

  object-fit: cover;
}


/* =========================================================
   LARGE BANNER
   ========================================================= */

.ref-wide-banner {
  min-height: 520px;

  margin-top: 90px;

  display: grid;

  grid-template-columns:
    .9fr
    1.1fr;

  overflow: hidden;

  background: #f4ece4;
}

.ref-wide-banner > div {
  display: flex;
  flex-direction: column;

  justify-content: center;

  padding:
    65px
    70px;
}

.ref-wide-banner > div > span {
  color: var(--ref-green);

  font-size: 10px;
  font-weight: 800;

  letter-spacing: .14em;
}

.ref-wide-banner h2 {
  max-width: 560px;

  margin: 14px 0 20px;

  color: var(--ref-green);

  font-size: clamp(42px, 4vw, 62px);
  line-height: .98;

  letter-spacing: -.06em;
}

.ref-wide-banner p {
  max-width: 470px;

  margin: 0 0 28px;

  color: #68706c;

  font-size: 14px;
  line-height: 1.65;
}

.ref-wide-banner a {
  width: fit-content;

  min-height: 44px;

  display: inline-flex;
  align-items: center;

  padding: 0 23px;

  border-radius: 999px;

  background: var(--ref-green);

  color: white;

  font-size: 12px;
  font-weight: 700;

  text-decoration: none;
}

.ref-wide-banner > img {
  width: 100%;
  height: 100%;

  min-height: 520px;

  object-fit: cover;
}


/* =========================================================
   SERVICES
   ========================================================= */

.ref-service-grid {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 20px;
}

.ref-service-grid article {
  overflow: hidden;

  background: #f5f5f2;
}

.ref-service-grid article > div {
  min-height: 155px;

  padding:
    30px
    30px
    24px;
}

.ref-service-grid h3 {
  margin: 0 0 10px;

  color: var(--ref-green);

  font-size: 22px;

  letter-spacing: -.035em;
}

.ref-service-grid p {
  max-width: 300px;

  margin: 0;

  color: #747974;

  font-size: 12px;
  line-height: 1.55;
}

.ref-service-grid img {
  width: 100%;
  height: 230px;

  display: block;

  object-fit: cover;
}


/* =========================================================
   STATUS
   ========================================================= */

.ref-action-message,
.ref-message {
  margin-top: 25px;

  padding: 14px 18px;

  border-radius: 6px;

  background: #eef5f1;

  color: var(--ref-green);

  font-size: 13px;
}

.ref-error {
  background: #fff1f0;
  color: #9c2720;
}

.ref-skeleton-line {
  width: 75%;
  height: 15px;

  margin-top: 15px;
}

.ref-skeleton-line.short {
  width: 40%;
}


