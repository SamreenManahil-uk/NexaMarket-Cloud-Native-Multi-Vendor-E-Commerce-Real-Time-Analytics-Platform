:root {
  font-family: "Avenir Next", Avenir, "Segoe UI", sans-serif;
  --primary: #4937cc;
  --primary-dark: #332394;
  --secondary: #eeeaff;
  --accent: #f58264;
  --accent-ink: #a63d26;
  --success: #176847;
  --background: #fafafc;
  --surface: #fff;
  --surface-soft: #f2f3f8;
  --text: #202139;
  --text-muted: #626379;
  --border: #e4e4ef;
  --shadow-sm: 0 4px 15px #28235a06;
  --shadow-md: 0 14px 35px #28235a12;
  --shadow-lg: 0 24px 60px #28235a20;
  --radius-sm: 10px;
  --radius-md: 18px;
  --radius-lg: 28px;
  --radius-pill: 999px;
  --space-1: 4px;
  --space-2: 8px;
  --space-3: 12px;
  --space-4: 16px;
  --space-5: 24px;
  --space-6: 32px;
  --space-7: 48px;
  --space-8: 64px;
  color: var(--text);
  background: var(--background);
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  font-size: 15px;
  line-height: 1.6;
}
* {
  box-sizing: border-box;
}
body {
  margin: 0;
}
a {
  color: inherit;
  text-underline-offset: 4px;
}
button,
input,
select {
  font: inherit;
}
button,
a,
input {
  -webkit-tap-highlight-color: transparent;
}
button {
  cursor: pointer;
}
button,
a {
  touch-action: manipulation;
}
button {
  border: 1px solid var(--border);
  background: var(--surface);
  color: var(--text);
  padding: 11px 18px;
  border-radius: var(--radius-sm);
  font-weight: 650;
  transition:
    background 0.2s,
    transform 0.2s,
    box-shadow 0.2s;
}
button:hover:not(:disabled) {
  background: var(--secondary);
}
button:disabled {
  cursor: not-allowed;
  color: var(--text-muted);
}
:focus-visible {
  outline: 3px solid var(--primary);
  outline-offset: 5px;
}
h1,
h2,
h3,
p {
  margin: 0;
}
h1,
h2,
h3 {
  line-height: 1.15;
}
h1,
h2 {
  letter-spacing: -0.045em;
}
h1 {
  font-size: clamp(2.6rem, 4.7vw, 4.7rem);
  font-weight: 750;
}
h2 {
  font-size: clamp(1.6rem, 2.5vw, 2.15rem);
  font-weight: 730;
}
h3 {
  font-size: 1.05rem;
  font-weight: 700;
  letter-spacing: -0.025em;
}
.container {
  max-width: 1360px;
  margin: auto;
  padding-inline: 48px;
}
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}
.skip-link {
  position: fixed;
  top: -100px;
  left: 16px;
  background: var(--surface);
  z-index: 100;
  padding: 12px 20px;
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow-md);
}
.skip-link:focus {
  top: 12px;
}
.site-header {
  position: sticky;
  top: 0;
  z-index: 30;
  background: #fffffff5;
  backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--border);
}
.header-inner {
  min-height: 90px;
  display: flex;
  align-items: center;
  gap: 38px;
}
.brand {
  display: inline-flex;
  align-items: center;
  font-size: 1.65rem;
  font-weight: 800;
  letter-spacing: -0.065em;
  text-decoration: none;
  white-space: nowrap;
}
.brand-light {
  font-weight: 550;
}
.brand-mark {
  display: grid;
  place-items: center;
  position: relative;
  background: var(--primary);
  color: #fff;
  border-radius: 13px;
  width: 40px;
  height: 40px;
  margin-right: 10px;
  font-size: 2rem;
  font-weight: 800;
  line-height: 1;
  padding-bottom: 6px;
  transform: rotate(-5deg);
}
.brand-mark span {
  position: absolute;
  color: #ffc2a7;
  font-size: 1rem;
  right: 3px;
  top: 2px;
}
.brand-dot,
.coral-dot {
  color: var(--accent-ink);
}
.search-preview {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10px;
  border: 1px solid var(--border);
  border-radius: var(--radius-pill);
  background: var(--surface-soft);
  padding: 10px 16px;
  color: var(--text-muted);
}
.search-preview > span:first-child {
  font-size: 1.8rem;
  line-height: 1;
}
.search-preview input {
  width: 100%;
  min-width: 0;
  border: 0;
  background: transparent;
  color: var(--text-muted);
  opacity: 1;
  font-size: 0.85rem;
}
.search-preview input::placeholder {
  color: var(--text-muted);
  opacity: 1;
}
.soon-label {
  font-size: 0.7rem;
  white-space: nowrap;
  border: 1px solid #d7d5e5;
  padding: 2px 8px;
  border-radius: var(--radius-pill);
}
.header-utilities {
  display: flex;
  gap: 20px;
}
.utility-button {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0;
  border: 0;
  background: none;
  font-size: 0.8rem;
  text-align: left;
}
.utility-button > span:first-child {
  font-size: 1.8rem;
  color: var(--text);
}
.utility-button small {
  display: block;
  font-size: 0.7rem;
  font-weight: 500;
}
.nav-row {
  border-top: 1px solid #f1f0f6;
}
.nav-row nav {
  display: flex;
  align-items: center;
  gap: 30px;
  min-height: 45px;
  font-size: 0.8rem;
}
.nav-row a {
  text-decoration: none;
  font-weight: 650;
  min-height: 44px;
  display: flex;
  align-items: center;
  gap: 10px;
}
.nav-row a:hover {
  color: var(--primary);
}
.nav-note {
  margin-left: auto;
  color: var(--text-muted);
  font-size: 0.74rem;
}
.hero {
  margin: 30px 0 52px;
  border-radius: var(--radius-lg);
  padding: 55px 48px 42px;
  display: grid;
  grid-template-columns: 1.15fr 1fr;
  position: relative;
  isolation: isolate;
  gap: 12px;
  overflow: hidden;
  background:
    radial-gradient(ellipse at 91% 70%, #efd9f5 0, transparent 47%),
    linear-gradient(115deg, #efedff, #f5f2ff 60%, #e3e8ff);
  min-height: 445px;
}
.hero-copy {
  position: relative;
  z-index: 2;
}
.hero-kicker {
  display: flex;
  align-items: center;
  gap: 8px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.13em;
  font-size: 0.7rem;
  color: var(--primary-dark);
}
.hero-kicker span {
  font-size: 1.2rem;
}
.hero h1 {
  margin: 19px 0 20px;
}
.hero h1 > span {
  color: var(--primary);
}
.hero-description {
  color: #555572;
  font-size: 0.94rem;
  line-height: 1.8;
}
.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 28px;
  padding: 13px 23px;
  border-radius: var(--radius-pill);
  text-decoration: none;
  font-weight: 650;
  font-size: 0.85rem;
  transition:
    background 0.2s,
    transform 0.2s,
    box-shadow 0.2s;
}
.button-primary {
  color: #fff;
  background: var(--primary);
  border: 1px solid var(--primary);
  box-shadow: 0 5px 14px #4937cc20;
}
.button-primary:hover,
button.button-primary:hover:not(:disabled) {
  background: var(--primary-dark);
  box-shadow: 0 8px 22px #4937cc30;
  transform: translateY(-2px);
}
.hero .button {
  margin-top: 26px;
}
.hero-footnote {
  font-size: 0.7rem;
  color: var(--text-muted);
  margin-top: 14px;
}
.hero-art {
  position: relative;
  min-height: 345px;
}
.hero-ring {
  width: 335px;
  height: 335px;
  border: 1px solid #fff;
  box-shadow:
    0 0 0 32px #ffffff30,
    0 0 0 65px #ffffff25;
  border-radius: 50%;
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
}
.hero-spark {
  position: absolute;
  right: 4%;
  top: -20px;
  color: var(--accent-ink);
  font-size: 55px;
  transform: rotate(12deg);
}
.hero-tile {
  position: absolute;
  border: 5px solid #ffffffa0;
  box-shadow: var(--shadow-lg);
  background: var(--art-bg);
  color: var(--art-ink);
  border-radius: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
}
.hero-tile svg {
  width: 100%;
  height: 85%;
  filter: drop-shadow(0 12px 5px #28235a15);
}
.hero-tile > span {
  font-size: 0.7rem;
  letter-spacing: 0.04em;
  color: var(--text);
  padding-bottom: 12px;
}
.tile-notebook {
  width: 185px;
  height: 212px;
  top: 12px;
  left: 0;
  transform: rotate(-12deg);
}
.tile-mug {
  width: 200px;
  height: 210px;
  right: -3px;
  top: 115px;
  transform: rotate(10deg);
  z-index: 2;
}
.tile-bottle {
  width: 138px;
  height: 154px;
  top: 205px;
  left: 64px;
  transform: rotate(-6deg);
  z-index: 3;
}
.discovery-note {
  position: absolute;
  top: 10px;
  right: 5px;
  font-size: 0.7rem;
  font-weight: 650;
  line-height: 1.3;
  background: #fff;
  border-radius: var(--radius-pill);
  padding: 12px 20px;
  display: flex;
  align-items: center;
  gap: 9px;
  transform: rotate(6deg);
  box-shadow: var(--shadow-sm);
  z-index: 3;
}
.discovery-note > span {
  font-size: 1.8rem;
  color: var(--success);
}
.hero-art-label {
  position: absolute;
  bottom: -14px;
  right: 0;
  font-size: 0.7rem;
  color: var(--text-muted);
}
.theme-indigo {
  --art-bg: #e6e7fc;
  --art-ink: #6252b8;
}
.theme-peach {
  --art-bg: #ffe6d8;
  --art-ink: #bb674a;
}
.theme-mint {
  --art-bg: #dbefe5;
  --art-ink: #357e69;
}
.theme-lilac {
  --art-bg: #ede2f7;
  --art-ink: #9364aa;
}
.section-heading {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 24px;
  margin-bottom: 24px;
}
.eyebrow {
  text-transform: uppercase;
  font-size: 0.7rem;
  letter-spacing: 0.15em;
  font-weight: 750;
  color: var(--primary);
  margin-bottom: 9px;
}
.text-link {
  font-size: 0.8rem;
  font-weight: 650;
  text-decoration: none;
  display: inline-flex;
  gap: 15px;
  align-items: center;
  min-height: 44px;
}
.text-link:hover {
  color: var(--primary);
}
.category-section {
  margin-bottom: 50px;
}
.category-list {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 12px;
}
.category-chip {
  display: flex;
  align-items: center;
  gap: 8px;
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 10px;
  min-height: 91px;
  text-align: left;
  background: var(--surface);
  position: relative;
  min-width: 0;
  box-shadow: var(--shadow-sm);
}
.category-chip .category-artwork {
  width: 52px;
  height: 60px;
  flex-shrink: 0;
  color: var(--art-ink);
  background: var(--art-bg);
  border-radius: 12px;
}
.category-chip > span:not(.all-icon):not(.category-arrow) {
  font-size: 0.78rem;
  line-height: 1.4;
  overflow-wrap: anywhere;
}
.category-chip small {
  display: block;
  font-size: 0.7rem;
  font-weight: 500;
  margin-top: 4px;
  color: var(--text-muted);
}
.category-chip[aria-pressed="true"] {
  border-color: var(--primary);
  box-shadow: 0 0 0 1px var(--primary);
  background: #f3f1ff;
}
.category-chip:hover {
  transform: translateY(-3px);
  box-shadow: var(--shadow-md);
}
.category-arrow {
  margin-left: auto;
  align-self: flex-start;
  color: var(--primary);
  font-size: 0.9rem;
}
.all-icon {
  font-size: 2.4rem;
  color: var(--primary);
  background: var(--secondary);
  border-radius: 12px;
  width: 50px;
  flex-shrink: 0;
  text-align: center;
}
.sort-label {
  font-size: 0.75rem;
  color: var(--text-muted);
  border: 1px solid var(--border);
  border-radius: var(--radius-pill);
  padding: 8px 14px;
  background: #fff;
  white-space: nowrap;
}
.catalogue-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
  border-top: 1px solid var(--border);
  padding: 16px 0 24px;
  color: var(--text-muted);
  font-size: 0.7rem;
}
.results-summary {
  font-size: 0.8rem;
}
.results-summary strong {
  color: var(--text);
}
.product-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 22px;
}
.product-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  transition:
    transform 0.22s,
    box-shadow 0.22s,
    border-color 0.22s;
  min-width: 0;
  box-shadow: var(--shadow-sm);
}
.product-card:hover,
.product-card:focus-within {
  transform: translateY(-5px);
  box-shadow: var(--shadow-md);
  border-color: #c5bdec;
}
.product-link {
  display: flex;
  flex-direction: column;
  text-decoration: none;
  height: 100%;
  border-radius: var(--radius-md);
}
.card-visual {
  position: relative;
  padding: 8px 8px 0;
}
.product-image {
  aspect-ratio: 1.13;
  background: var(--art-bg);
  overflow: hidden;
  display: grid;
  place-items: center;
  border-radius: 12px;
  isolation: isolate;
  position: relative;
}
.product-image img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  background: #fff;
  min-height: 0;
}
.image-fallback {
  width: 100%;
  height: 100%;
  position: relative;
  display: grid;
  place-items: center;
  background: radial-gradient(ellipse at 20% 10%, #ffffff88, transparent 60%);
  color: var(--art-ink);
}
.image-fallback > .category-artwork {
  width: 83%;
  height: 83%;
  position: relative;
  z-index: 1;
  filter: drop-shadow(0 12px 7px #28235a15);
  transition: transform 0.3s;
  transform: rotate(-5deg);
}
.product-card:hover .image-fallback > .category-artwork {
  transform: rotate(0) scale(1.04);
}
.artwork-orbit {
  position: absolute;
  width: 75%;
  aspect-ratio: 1;
  border-radius: 50%;
  background: #ffffff30;
  border: 1px solid #ffffff65;
  top: 14%;
  left: 25%;
}
.artwork-caption {
  position: absolute;
  bottom: 9px;
  left: 12px;
  color: var(--text-muted);
  font-size: 0.7rem;
  z-index: 2;
  letter-spacing: 0.035em;
}
.category-badge {
  font-size: 0.7rem;
  font-weight: 650;
  background: #ffffffed;
  color: var(--text);
  padding: 5px 9px;
  border: 1px solid #ffffff90;
  border-radius: var(--radius-pill);
}
.card-visual > .category-badge {
  position: absolute;
  top: 20px;
  left: 20px;
  max-width: calc(100% - 66px);
  overflow-wrap: anywhere;
}
.card-open {
  position: absolute;
  right: 18px;
  top: 20px;
  width: 25px;
  height: 25px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: #ffffffaa;
  color: var(--primary);
  font-size: 0.8rem;
}
.card-content {
  padding: 18px;
  display: flex;
  flex: 1;
  flex-direction: column;
}
.store {
  font-size: 0.7rem;
  color: var(--text-muted);
  overflow-wrap: anywhere;
}
.card-content h3 {
  margin-top: 6px;
  line-height: 1.45;
  overflow-wrap: anywhere;
}
.card-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 6px;
  padding: 18px 0 16px;
  margin-top: auto;
  flex-wrap: wrap;
}
.price {
  font-size: 1.45rem;
  font-weight: 750;
  letter-spacing: -0.04em;
}
.stock {
  font-size: 0.7rem;
  color: var(--success);
  background: #e9f5ed;
  padding: 4px 8px;
  border-radius: var(--radius-pill);
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-weight: 650;
  white-space: nowrap;
}
.stock > span {
  font-size: 0.7rem;
}
.stock.unavailable {
  color: #755231;
  background: #f6eddf;
}
.view-link {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 13px;
  border-top: 1px solid var(--border);
  font-size: 0.73rem;
  font-weight: 650;
  color: var(--primary);
}
.view-link > span {
  font-size: 1rem;
}
.pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 28px;
  margin: 35px 0 50px;
}
.pagination button {
  border-radius: var(--radius-pill);
  font-size: 0.8rem;
}
.pagination button:disabled {
  background: var(--surface-soft);
  color: #737386;
}
.pagination span {
  font-size: 0.78rem;
  color: var(--text-muted);
}
.stock-discovery {
  background: linear-gradient(115deg, #e3f1e8, #f1f7ed);
  border: 1px solid #dbe9df;
  border-radius: var(--radius-lg);
  padding: 35px 40px;
  display: grid;
  grid-template-columns: 1fr 1.4fr;
  gap: 60px;
  overflow: hidden;
}
.stock-discovery > div:first-child {
  position: relative;
}
.stock-discovery .eyebrow {
  color: var(--success);
}
.stock-discovery h2 {
  font-size: 2.2rem;
  position: relative;
  z-index: 1;
}
.stock-discovery p:not(.eyebrow) {
  max-width: 290px;
  font-size: 0.8rem;
  color: #4c6657;
  margin-top: 14px;
  position: relative;
  z-index: 1;
}
.stock-decoration {
  position: absolute;
  bottom: -50px;
  right: -10px;
  font-size: 130px;
  color: #c8e2d0;
  line-height: 1;
}
.stock-discovery-links {
  display: flex;
  flex-direction: column;
  gap: 10px;
  justify-content: center;
}
.stock-discovery-links a {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  padding: 14px 20px;
  border: 1px solid #d9e6db;
  background: #ffffffcc;
  border-radius: 14px;
  text-decoration: none;
  transition:
    transform 0.2s,
    box-shadow 0.2s;
}
.stock-discovery-links a:hover {
  transform: translateX(3px);
  box-shadow: var(--shadow-sm);
}
.stock-discovery-links small {
  display: block;
  font-size: 0.7rem;
  color: var(--success);
}
.stock-discovery-links strong {
  display: block;
  font-size: 0.85rem;
}
.stock-discovery-links a > span:first-child > span {
  font-size: 0.7rem;
  color: var(--text-muted);
}
.discovery-price {
  display: flex;
  gap: 25px;
  font-size: 0.95rem;
  font-weight: 700;
}
.discovery-price > span {
  color: var(--success);
}
.status-panel {
  padding: 50px 24px;
  text-align: center;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  margin: 12px 0 30px;
  background: linear-gradient(130deg, #f0edff, #fff6ef);
}
.status-icon {
  display: grid;
  place-items: center;
  margin: 0 auto 20px;
  width: 55px;
  height: 55px;
  border-radius: 18px;
  background: var(--surface);
  color: var(--primary);
  font-size: 1.8rem;
  box-shadow: var(--shadow-sm);
}
.status-panel h2 {
  font-size: 1.7rem;
}
.status-panel p {
  margin: 14px auto;
  color: var(--text-muted);
  max-width: 530px;
}
.status-actions {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20px;
  flex-wrap: wrap;
  margin-top: 24px;
  font-size: 0.8rem;
}
.status-actions button {
  border-radius: var(--radius-pill);
}
.inline-error {
  padding: 16px;
  background: #fff1e8;
  border: 1px solid #edc5b0;
  border-radius: var(--radius-md);
  margin-bottom: 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  font-size: 0.85rem;
}
.inline-loading {
  margin-bottom: 20px;
  color: var(--text-muted);
}
