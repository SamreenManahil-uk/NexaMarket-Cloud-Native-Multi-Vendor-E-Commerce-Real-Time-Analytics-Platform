  border-top: 1px solid var(--nm-border);
  background: #fff;
}

.mobile-shopcart-menu nav {
  display: grid;
  gap: 4px;
  padding-top: 14px;
  padding-bottom: 20px;
}

.mobile-shopcart-menu a {
  padding: 12px 4px;
  border-bottom: 1px solid #efefec;
  color: var(--nm-text);
  text-decoration: none;
  font-weight: 650;
}

.mobile-search {
  display: flex;
  gap: 8px;
  margin-top: 12px;
}

.mobile-search input {
  min-width: 0;
  flex: 1;
  height: 44px;
  padding: 0 16px;
  border: 1px solid var(--nm-border);
  border-radius: var(--nm-pill);
}

.mobile-search button {
  padding: 0 18px;
  border: 0;
  border-radius: var(--nm-pill);
  background: var(--nm-green);
  color: #fff;
  font-weight: 700;
}

.site-footer {
  margin-top: 80px;
  padding: 50px 0;
  border-top: 1px solid var(--nm-border);
  background: #fff;
}

.site-footer > .container {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 30px;
}

.site-footer .brand {
  color: var(--nm-green);
  text-decoration: none;
  font-size: 25px;
  font-weight: 800;
}

.site-footer p {
  margin: 10px 0 0;
  color: var(--nm-muted);
}

.site-footer a {
  color: var(--nm-green);
  font-weight: 700;
}

.development-label {
  color: var(--nm-muted);
  font-size: 12px;
}

@media (max-width: 1050px) {
  .desktop-primary-nav {
    display: none;
  }

  .shopcart-search {
    max-width: none;
  }
}

@media (max-width: 760px) {
  .container {
    width: min(calc(100% - 32px), var(--nm-container));
  }

  .shopcart-topbar-inner {
    min-height: 32px;
